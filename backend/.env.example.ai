# AI Services Control
# Set to false to disable AI services during development (faster startup with --reload)
# Set to true for production
ENABLE_AI=true

# Note: When ENABLE_AI=false, endpoints that require AI will return errors
# This is useful for:
# - Fast development cycles with uvicorn --reload
# - Testing auth, user management, and non-AI routes
# - Debugging without waiting for heavy ML models to load
