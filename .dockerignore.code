# Code Studio Docker - Ignore unnecessary files for faster builds

# Git
.git
.gitignore
.gitattributes

# Documentation
docs/
*.md
!README.md

# IDE and Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS Files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.env
.venv
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/
build/
dist/

# Storage and Data
storage/
*.db
*.sqlite
*.faiss

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Build artifacts
*.o
*.a
*.exe

# Environment files (will be passed via docker-compose)
.env*
!.env.example

# Other services not needed for Code Studio
frontend/src/app/(dashboard)/analytics/
frontend/src/app/(dashboard)/documents/
frontend/src/app/(dashboard)/research/
frontend/src/app/(dashboard)/githubrepos/
frontend/src/app/(dashboard)/decisionvault/
frontend/src/app/(dashboard)/jobprep/
frontend/src/app/(dashboard)/overview/
frontend/src/app/(dashboard)/settings/

# Blockchain (not needed for Code Studio)
blockchain/

# AI Core (not needed for Code Studio)
ai-core/

# Scripts
scripts/
