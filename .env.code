# Code Studio Standalone Configuration
# Copy this file and set your actual API keys

# Required: Groq API Key for AI features
GROQ_API_KEY=your_groq_api_key_here

# Optional: Additional Groq API keys for rotation/redundancy
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Port Configuration (modify if you have port conflicts)
# Backend port (internal): 8001
# Frontend port (internal): 3001
# To change exposed ports, edit docker-compose.code.yml

