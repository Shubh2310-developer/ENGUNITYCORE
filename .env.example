# ==========================================
# Supabase Configuration (Required)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here_base64_encoded
SUPABASE_AUTH_CALLBACK_URL=http://localhost:3000/callback

# ==========================================
# Database Configuration (Required)
# ==========================================
DATABASE_URL=postgresql://user:pass@localhost:5432/engunity

# ==========================================
# Application Configuration (Required)
# ==========================================
SECRET_KEY=your_secret_key_here_minimum_32_characters_long
PROJECT_NAME="Engunity AI"
API_V1_STR="/api/v1"

# ==========================================
# AI Services (Required)
# ==========================================
# Use a single key
GROQ_API_KEY=your_groq_api_key_here
# OR use multiple keys for rotation (comma-separated)
GROQ_API_KEYS=key1,key2,key3

# Optional AI Services
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ==========================================
# MongoDB (Required)
# ==========================================
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=engunity

# ==========================================
# Redis (Optional - defaults provided)
# ==========================================
REDIS_URL=redis://localhost:6379/0

# ==========================================
# GitHub Integration (Optional)
# ==========================================
# Get your token from: https://github.com/settings/tokens
# Required scopes: repo, read:user
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# ==========================================
# Frontend Configuration (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_SUPABASE_AUTH_CALLBACK_URL=http://localhost:3000/callback
